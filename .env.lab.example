# JARVIS — variaveis do laboratorio (DT-004)
# Copiar para .env.lab na VM de lab. Nunca usar chave de producao aqui.
# Lista completa: backend/config.py (27 settings). As do .env.example original
# cobrem 16; esta lista cobre todas.

# --- App ---
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
# IP publico ou DNS da VM de lab, porta 3000. Usado no CORS do backend.
JARVIS_FRONTEND_ORIGIN=http://localhost:3000
# Mesmo host, porta 8000. Embutido no bundle do frontend em tempo de build.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Tempo real (Convex, nuvem). Sem isso o frontend roda em modo demo. ---
CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=

# --- LLM de sintese. Anthropic e o primario, Gemini o fallback e a voz. ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Pesquisa ---
EXA_API_KEY=
SIXTYFOUR_API_KEY=
BROWSER_USE_API_KEY=
BROWSER_USE_PROFILE_ID=
HIBP_API_KEY=

# --- Identificacao facial (so em lab, DT-003) ---
PIMEYES_ACCOUNT_POOL=[]
PIMEYES_EMAIL=
PIMEYES_PASSWORD=

# --- Criacao autonoma de contas (so em lab, DT-003) ---
AGENTMAIL_API_KEY=

# --- Memoria, observabilidade, avaliacao ---
SUPERMEMORY_API_KEY=
LAMINAR_API_KEY=
HUD_API_KEY=

# --- Sandbox e cofre (nao usados no fluxo principal) ---
DAYTONA_API_KEY=
DAYTONA_API_URL=
OP_VAULT_ID=

# --- Captura ---
TELEGRAM_BOT_TOKEN=

# --- Persistencia. Declarada no config, sem cliente no codigo. Pode ficar vazia. ---
MONGODB_URI=
